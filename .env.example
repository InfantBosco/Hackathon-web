# ==========================================
# HACKNEX 2026 MASTER ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# Server & Environment
# ------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ------------------------------------------
# Database (PostgreSQL via Neon)
# ------------------------------------------
# Connection string with pooled connection for app
DATABASE_URL="postgresql://user:password@host/hacknex?sslmode=require&pgbouncer=true"
# Direct connection string for Prisma migrations
DIRECT_URL="postgresql://user:password@host/hacknex?sslmode=require"

# ------------------------------------------
# Authentication (Better Auth / JWT)
# ------------------------------------------
BETTER_AUTH_SECRET=your_32_character_better_auth_secret_here
BETTER_AUTH_URL=http://localhost:4000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ------------------------------------------
# Transactional Email (Resend)
# ------------------------------------------
RESEND_API_KEY=re_123456789_placeholder
EMAIL_FROM="HackNEX Team <noreply@hacknex.in>"

# ------------------------------------------
# Media Storage & CDN (Cloudinary)
# ------------------------------------------
CLOUDINARY_CLOUD_NAME=hacknex-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_placeholder
VITE_CLOUDINARY_CLOUD_NAME=hacknex-cloud

# ------------------------------------------
# Karunya Payment Gateway (Pending Details)
# ------------------------------------------
PAYMENT_BASE_URL=https://payment.karunya.edu/api/v1
PAYMENT_API_KEY=karunya_pay_api_key_placeholder
PAYMENT_SECRET=karunya_pay_secret_placeholder
PAYMENT_WEBHOOK_SECRET=karunya_pay_webhook_secret_placeholder
PAYMENT_MERCHANT_ID=KARUNYA_HACKNEX_2026

# ------------------------------------------
# Monitoring & Error Tracking (Sentry)
# ------------------------------------------
SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0

# ------------------------------------------
# Frontend Environment Configuration
# ------------------------------------------
VITE_API_URL=http://localhost:4000/api
VITE_APP_TITLE="HackNEX 2026 | National Level Hackathon"
