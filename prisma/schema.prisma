// HackNEX 2026 Database Schema
// Database Design Baseline Specification v1.0
// Source of truth: DB.pdf & TAD.pdf

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum FoodPreference {
  VEG
  NON_VEG
}

enum TeamStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  CONFIRMED
  CANCELLED
}

enum RegistrationStatus {
  DRAFT
  READY_FOR_PAYMENT
  PAYMENT_PENDING
  PAYMENT_VERIFIED
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  INITIATED
  PROCESSING
  SUCCESS
  VERIFIED
  FAILED
  EXPIRED
  CANCELLED
}

enum MediaCategory {
  HERO
  ABOUT
  VENUE
  SPONSOR
  ORGANIZER
  OTHER
}

// ==========================================
// AUTHENTICATION MODELS
// ==========================================

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)

  accounts     Account[]
  sessions     Session[]
  teams        Team[]        @relation("CaptainTeams")
  admin        Admin?
  participants Participant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

// ==========================================
// HACKATHON REGISTRATION & TEAM MODELS
// ==========================================

model Team {
  id            String     @id @default(uuid())
  teamName      String     @unique
  captainUserId String     @unique
  status        TeamStatus @default(DRAFT)

  captain      User          @relation("CaptainTeams", fields: [captainUserId], references: [id])
  participants Participant[]
  registration Registration?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("teams")
}

model Participant {
  id             String         @id @default(uuid())
  teamId         String
  userId         String?
  name           String
  email          String         @unique
  phone          String
  college        String
  department     String
  yearOfStudy    String
  linkedinUrl    String?
  foodPreference FoodPreference
  isCaptain      Boolean        @default(false)

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teamId])
  @@index([college])
  @@index([department])
  @@index([phone])
  @@map("participants")
}

model Registration {
  id             String             @id @default(uuid())
  registrationId String             @unique
  teamId         String             @unique
  status         RegistrationStatus @default(DRAFT)
  submittedAt    DateTime?
  confirmedAt    DateTime?

  team     Team      @relation(fields: [teamId], references: [id])
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("registrations")
}

model Payment {
  id                String        @id @default(uuid())
  registrationId    String
  amount            Int
  currency          String        @default("INR")
  provider          String
  transactionId     String?       @unique
  providerReference String?
  status            PaymentStatus @default(PENDING)
  verifiedAt        DateTime?

  registration Registration @relation(fields: [registrationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([registrationId])
  @@index([status])
  @@map("payments")
}

// ==========================================
// CONTENT MANAGEMENT MODELS
// ==========================================

model Domain {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String   @db.Text
  icon         String?
  displayOrder Int
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("domains")
}

model ScheduleItem {
  id           String    @id @default(uuid())
  title        String
  description  String?   @db.Text
  startTime    DateTime
  endTime      DateTime?
  location     String?
  day          String
  displayOrder Int
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startTime])
  @@index([displayOrder])
  @@map("schedule_items")
}

model Prize {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  amount       Int?
  position     Int?
  displayOrder Int
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("prizes")
}

model Sponsor {
  id           String   @id @default(uuid())
  name         String
  logoUrl      String?  @db.Text
  websiteUrl   String?  @db.Text
  tier         String?
  displayOrder Int
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("sponsors")
}

model FAQ {
  id           String   @id @default(uuid())
  question     String   @db.Text
  answer       String   @db.Text
  displayOrder Int
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayOrder])
  @@map("faqs")
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String    @db.Text
  publishedAt DateTime?
  isPublished Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publishedAt])
  @@map("announcements")
}

// ==========================================
// MEDIA MANAGEMENT MODEL
// ==========================================

model Media {
  id           String        @id @default(uuid())
  publicId     String        @unique
  secureUrl    String        @db.Text
  resourceType String
  category     MediaCategory
  title        String?
  altText      String?
  displayOrder Int
  isActive     Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([displayOrder])
  @@map("media")
}

// ==========================================
// ADMINISTRATION & AUDIT MODELS
// ==========================================

model Admin {
  id       String  @id @default(uuid())
  userId   String  @unique
  isActive Boolean @default(true)

  user      User       @relation(fields: [userId], references: [id])
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

model AuditLog {
  id         String  @id @default(uuid())
  adminId    String
  action     String
  entityType String
  entityId   String?
  metadata   Json?

  admin Admin @relation(fields: [adminId], references: [id])

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
